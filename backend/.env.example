PROJECT_NAME="Dynamic Transcript Evaluation Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/transcript_eval"
# Dedicated Postgres database for the test suite only - never point this at DATABASE_URL
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/transcript_eval_test"

# Browser origins allowed to call this API with credentials (comma-separated, no wildcard)
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# Security / Auth
# Generate with: openssl rand -hex 32  -- never reuse this example value
JWT_SECRET="REPLACE_WITH_A_RANDOM_64_CHAR_HEX_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Provider Agnostic)
LLM_API_KEY="sk-placeholder-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4o"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# STT Configuration (Groq Whisper)
GROQ_STT_KEY="gsk-placeholder-key"
GROQ_STT_BASE_URL="https://api.groq.com/openai/v1"
# Use large-v3, not -turbo. On Groq's free tier both share the same quota
# (20 RPM / 28,800 audio-seconds per day), and turbo is a distilled model that
# is measurably weaker on Hindi and other Indic languages. Turbo only buys
# latency, and this pipeline is queue-bound rather than latency-bound.
STT_MODEL_NAME="whisper-large-v3"
STT_MAX_RETRIES=3
# Transcripts scoring below this duration-weighted mean token probability are
# flagged unreliable in the report.
STT_MIN_CONFIDENCE=0.55
# Model that assigns Agent/Customer roles to Whisper segments. Defaults to
# LLM_MODEL_NAME; point it at a cheaper/smaller model if you have one.
# DIARIZATION_MODEL_NAME="llama-3.1-8b-instant"

# Job queue (Redis + arq). Transcription and evaluation run in a worker process
# so a slow provider, a rate limit, or a redeploy cannot lose an upload.
# Start the worker with:  arq app.workers.jobs.WorkerSettings
REDIS_URL="redis://localhost:6379/0"
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT=900
WORKER_MAX_TRIES=4

# MinIO Object Storage (audio recordings)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="call-recordings"
MINIO_SECURE=False
